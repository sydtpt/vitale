{
  "expo": {
    "name": "Orbe",
    "slug": "vitale-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vitale",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "runtimeVersion": "1.0.2",
    "updates": {
      "url": "https://u.expo.dev/127be066-b0bb-4469-bd58-d7e5c6c9cd22",
      "enabled": true
    },
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF7EE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sydtpt.vitale",
      "infoPlist": {
        "NSHealthShareUsageDescription": "O Orbe acessa seus dados do Apple Health — atividade, coração, corpo, sono, nutrição e treinos — para exibir seu histórico e gráficos.",
        "UIBackgroundModes": ["fetch"]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF7EE"
      },
      "package": "com.sydtpt.vitale"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#F25C2B"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "O Orbe acessa seus dados do Apple Health — atividade, coração, corpo, sono, nutrição e treinos — para exibir seu histórico e gráficos.",
          "background": true
        }
      ],
      "./plugins/withDevelopmentTeam.js",
      "./plugins/withHealthKitObjcxxBridge.js",
      "./plugins/withHealthKitBackgroundObservers.js",
      "./plugins/withDisableExplicitModules.js",
      "./plugins/withFmtConstevalFix.js",
      "./plugins/withCppModulemapFix.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

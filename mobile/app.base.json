{
  "expo": {
    "name": "Orbe",
    "slug": "vitale-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vitale",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": "1.0.5",
    "updates": {
      "url": "https://u.expo.dev/127be066-b0bb-4469-bd58-d7e5c6c9cd22",
      "enabled": true,
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sydtpt.vitale",
      "infoPlist": {
        "NSHealthShareUsageDescription": "O Orbe acessa seus dados do Apple Health — atividade, coração, corpo, sono, nutrição e treinos — para exibir seu histórico e gráficos.",
        "UIBackgroundModes": ["fetch"]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF7EE"
      },
      "package": "com.sydtpt.vitale"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "//": "Embarcadas no build nativo, não carregadas em runtime: existem já no primeiro frame, sem flash de fonte do sistema. Trocar esta lista exige rebuild nativo.",
          "fonts": [
            "./assets/fonts/Manrope-Regular.ttf",
            "./assets/fonts/Manrope-Medium.ttf",
            "./assets/fonts/Manrope-SemiBold.ttf",
            "./assets/fonts/Manrope-Bold.ttf",
            "./assets/fonts/GeistMono-Regular.ttf",
            "./assets/fonts/GeistMono-SemiBold.ttf",
            "./assets/fonts/GeistMono-Bold.ttf",
            "./assets/fonts/InstrumentSerif-Regular.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF7EE"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#F25C2B"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "O Orbe acessa seus dados do Apple Health — atividade, coração, corpo, sono, nutrição e treinos — para exibir seu histórico e gráficos.",
          "background": true
        }
      ],
      "./plugins/withDevelopmentTeam.js",
      "./plugins/withHealthKitObjcxxBridge.js",
      "./plugins/withHealthKitBackgroundObservers.js",
      "./plugins/withDisableExplicitModules.js",
      "./plugins/withCppModulemapFix.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

{
  "name": "life-organizer",
  "version": "0.1.0",
  "private": true,
  "description": "Rotina — Life organizer with Angular web dashboard and React Native mobile app",
  "workspaces": [
    "packages/*",
    "web",
    "mobile"
  ],
  "scripts": {
    "web:dev": "cd web && ng serve",
    "web:build": "cd web && ng build",
    "mobile:start": "cd mobile && npx expo start",
    "mobile:android": "cd mobile && npx expo run:android",
    "mobile:ios": "cd mobile && npx expo run:ios",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
